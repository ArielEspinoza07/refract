{
    "name": "arielespinoza07/refract",
    "description": "wrapper for native php reflection with fluent api",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ariel Espinoza",
            "email": "arielespinoza46@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "pestphp/pest": "^4.7.8",
        "phpstan/phpstan": "^2.3.1",
        "laravel/pint": "^1.32.1"
    },
    "autoload": {
        "psr-4": {
            "Refract\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Refract\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse",
        "test": "pest",
        "test:coverage": "pest --type-coverage --min=100",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
