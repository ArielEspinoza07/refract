{
    "name": "arielespinoza07/refract",
    "description": "A fluent, immutable and fully typed API for PHP's native reflection: classes, enums, methods, functions, properties, parameters, attributes and types.",
    "type": "library",
    "keywords": [
        "reflection",
        "introspection",
        "attributes",
        "types",
        "fluent",
        "immutable",
        "php-reflection"
    ],
    "homepage": "https://github.com/ArielEspinoza07/refract",
    "license": "MIT",
    "authors": [
        {
            "name": "Ariel Espinoza",
            "email": "arielespinoza46@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ArielEspinoza07/refract/issues",
        "source": "https://github.com/ArielEspinoza07/refract",
        "security": "https://github.com/ArielEspinoza07/refract/security/policy"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "pestphp/pest": "^4.7.8",
        "phpstan/phpstan": "^2.3.1",
        "laravel/pint": "^1.32.1",
        "pestphp/pest-plugin-type-coverage": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Refract\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Refract\\Tests\\": "tests/",
            "Refract\\Examples\\": "examples/"
        },
        "files": [
            "tests/Fixtures/functions.php"
        ]
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse",
        "test": "pest",
        "test:coverage": "pest --coverage --min=100",
        "test:types": "pest --type-coverage --min=100",
        "test:mutate": "pest --mutate --everything --parallel --path=src --min=95",
        "check": [
            "@lint",
            "@analyse",
            "@test:types",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
